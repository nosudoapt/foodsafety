# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — browser (anon) credentials. Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Migration runner ONLY (scripts/migrate.mjs). Superuser connection string, NOT
# the anon key — SQL migrations create tables/policies/roles.
# Supabase Dashboard → Project Settings → Database → Connection String → URI.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Server-only privileged key for the BTB API routes (src/lib/supabase-server.ts).
# Supabase Dashboard → Project Settings → API → service_role (secret).
# NEVER put this under a NEXT_PUBLIC_* name and never commit its value.
# Optional for now (routes fall back to the anon key with a warning); REQUIRED
# before running deploy/04-security-hardening.sql, which revokes anon access.
SUPABASE_SERVICE_ROLE_KEY=

# Login-vault encryption key (src/lib/vault-crypto.ts): openssl rand -base64 32
VAULT_ENC_KEY=
