# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — browser (anon) credentials. Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database administration connection, NOT the anon key. Existing production
# uses SQL Editor/runbooks; do not run the migration runner or create a ledger.
# See deploy/README.md and deploy/BTB_TEAM_SETUP.md.
# Supabase Dashboard → Project Settings → Database → Connection String → URI.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Optional server-only URL alias. The routes fall back to NEXT_PUBLIC_SUPABASE_URL
# for the URL only (URLs are not secrets).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# REQUIRED server-only privileged key for BTB inventory and team/operations APIs
# (src/lib/supabase-server.ts).
# Supabase Dashboard → Project Settings → API → service_role (secret).
# NEVER put this under a NEXT_PUBLIC_* name and never commit its value.
# There is deliberately no anon fallback.
SUPABASE_SERVICE_ROLE_KEY=

# BTB shared-workspace login details live in server-only src/lib/btb-auth.ts.
# Individual employee passwords live in the backend database. Session signing
# uses the existing SUPABASE_SERVICE_ROLE_KEY automatically; no BTB login env
# variables are required.

# Genuine Supabase profiles ID for server-authorized BTB document/marketing
# creation. Provision using: node scripts/provision-btb-uploader.mjs (Node 22+).
# An employee ID or a FoodSafe browser session must never be substituted.
BTB_UPLOADER_PROFILE_ID=

# Licence-expiry emails (server-only). BTB_EMAIL_FROM must use a sender/domain
# verified in Resend. Add actual manager/corporate addresses in Licence Reminders.
RESEND_API_KEY=
BTB_EMAIL_FROM=
# Vercel cron sends this as Authorization: Bearer <secret>; use a random value.
# The included daily schedule is 15:00 UTC / 09:00 America/Regina.
CRON_SECRET=

# Login-vault encryption key (src/lib/vault-crypto.ts): openssl rand -base64 32
VAULT_ENC_KEY=
